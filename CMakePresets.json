{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "win-amd64",
            "displayName": "Windows AMD64",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/win-amd64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_RC_COMPILER": "llvm-rc",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "Release",
                "REXSDK_DIR": "$env{REXSDK_DIR}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-amd64",
            "displayName": "Linux AMD64 (Steam Deck)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/linux-amd64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "Release",
                "REXSDK_DIR": "$env{REXSDK_DIR}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "mac-arm64",
            "displayName": "macOS ARM64",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/mac-arm64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "Release",
                "REXSDK_DIR": "$env{REXSDK_DIR}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-amd64-debug",
            "configurePreset": "win-amd64",
            "configuration": "Debug"
        },
        {
            "name": "win-amd64-release",
            "configurePreset": "win-amd64",
            "configuration": "Release"
        },
        {
            "name": "linux-amd64-debug",
            "configurePreset": "linux-amd64",
            "configuration": "Debug"
        },
        {
            "name": "linux-amd64-release",
            "configurePreset": "linux-amd64",
            "configuration": "Release"
        },
        {
            "name": "mac-arm64-debug",
            "configurePreset": "mac-arm64",
            "configuration": "Debug"
        },
        {
            "name": "mac-arm64-release",
            "configurePreset": "mac-arm64",
            "configuration": "Release"
        }
    ]
}
